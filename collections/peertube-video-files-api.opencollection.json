{
  "opencollection": "1.0.0",
  "info": {
    "name": "PeerTube Abuses Video Files API",
    "version": "8.1.0"
  },
  "items": [
    {
      "info": {
        "name": "Video Files",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Delete video HLS files",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://peertube2.cpy.re/api/v1/videos/:id/hls",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The object id, uuid or short uuid"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "resource_owner_password_credentials",
              "accessTokenUrl": "/api/v1/users/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Delete video HLS files"
        },
        {
          "info": {
            "name": "Delete video Web Video files",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://peertube2.cpy.re/api/v1/videos/:id/web-videos",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The object id, uuid or short uuid"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "resource_owner_password_credentials",
              "accessTokenUrl": "/api/v1/users/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "**PeerTube >= 6.0**"
        }
      ]
    }
  ],
  "bundled": true
}