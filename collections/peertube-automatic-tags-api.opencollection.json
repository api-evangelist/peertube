{
  "opencollection": "1.0.0",
  "info": {
    "name": "PeerTube Abuses Automatic Tags API",
    "version": "8.1.0"
  },
  "items": [
    {
      "info": {
        "name": "Automatic Tags",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get account auto tag policies on comments",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://peertube2.cpy.re/api/v1/automatic-tags/policies/accounts/:accountName/comments",
            "params": [
              {
                "name": "accountName",
                "value": "",
                "type": "path",
                "description": "account name to get auto tag policies"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "resource_owner_password_credentials",
              "accessTokenUrl": "/api/v1/users/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "**PeerTube >= 6.2**"
        },
        {
          "info": {
            "name": "Update account auto tag policies on comments",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://peertube2.cpy.re/api/v1/automatic-tags/policies/accounts/:accountName/comments",
            "params": [
              {
                "name": "accountName",
                "value": "",
                "type": "path",
                "description": "account name to update auto tag policies"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "resource_owner_password_credentials",
              "accessTokenUrl": "/api/v1/users/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "**PeerTube >= 6.2**"
        },
        {
          "info": {
            "name": "Get account available auto tags",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://peertube2.cpy.re/api/v1/automatic-tags/accounts/:accountName/available",
            "params": [
              {
                "name": "accountName",
                "value": "",
                "type": "path",
                "description": "account name to get auto tag policies"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "resource_owner_password_credentials",
              "accessTokenUrl": "/api/v1/users/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "**PeerTube >= 6.2**"
        },
        {
          "info": {
            "name": "Get server available auto tags",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://peertube2.cpy.re/api/v1/automatic-tags/server/available",
            "auth": {
              "type": "oauth2",
              "flow": "resource_owner_password_credentials",
              "accessTokenUrl": "/api/v1/users/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "**PeerTube >= 6.2**"
        }
      ]
    }
  ],
  "bundled": true
}