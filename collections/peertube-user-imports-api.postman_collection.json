          "name": "Send chunk for the resumable user import",
          "request": {
            "name": "Send chunk for the resumable user import",
            "description": {
              "content": "**PeerTube >= 6.1** Uses [a resumable protocol](https://github.com/kukhariev/node-uploadx/blob/master/proto.md) to continue, pause or resume the import of the archive",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "users",
                ":userId",
                "imports",
                "import-resumable"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "upload_id",
                  "value": "<string>",
                  "description": "(Required) Created session id to proceed with. If you didn't send chunks in the last hour, it is\nnot valid anymore and you need to initialize a new upload.\n"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "userId",
                  "description": "(Required) User id"
                }
              ]
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) Specifies the bytes in the file that the request is uploading.\n\nFor example, a value of `bytes 0-262143/1000000` shows that the request is sending the first\n262144 bytes (256 x 1024) in a 2,469,036 byte file.\n",
                "key": "Content-Range",
                "value": "<string>"
              },
              {
                "disabled": false,
                "description": "(Required) Size of the chunk that the request is sending.\n\nRemember that larger chunks are more efficient. PeerTube's web client uses chunks varying from\n1048576 bytes (~1MB) and increases or reduces size depending on connection health.\n",
                "key": "Content-Length",
                "value": "<number>"
              },
              {
                "key": "Content-Type",
                "value": "application/octet-stream"
              }
            ],
            "method": "PUT",
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "scope",
                  "value": "admin moderator user"
                },
                {
                  "key": "accessTokenUrl",
                  "value": "/api/v1/users/token"
                },
                {
                  "key": "grant_type",
                  "value": "password_credentials"
                }
              ]
            },
            "body": {
              "mode": "file"
            }
