{
  "opencollection": "1.0.0",
  "info": {
    "name": "PeerTube Abuses Logs API",
    "version": "8.1.0"
  },
  "items": [
    {
      "info": {
        "name": "Logs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Send client log",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://peertube2.cpy.re/api/v1/server/logs/client",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Send client log"
        },
        {
          "info": {
            "name": "Get instance logs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://peertube2.cpy.re/api/v1/server/logs",
            "auth": {
              "type": "oauth2",
              "flow": "resource_owner_password_credentials",
              "accessTokenUrl": "/api/v1/users/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Get instance logs"
        },
        {
          "info": {
            "name": "Get instance audit logs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://peertube2.cpy.re/api/v1/server/audit-logs",
            "auth": {
              "type": "oauth2",
              "flow": "resource_owner_password_credentials",
              "accessTokenUrl": "/api/v1/users/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Get instance audit logs"
        }
      ]
    }
  ],
  "bundled": true
}