            "name": "List account watched words",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://peertube2.cpy.re/api/v1/watched-words/accounts/:accountName/lists",
            "params": [
              {
                "name": "accountName",
                "value": "",
                "type": "path",
                "description": "account name to list watched words"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "resource_owner_password_credentials",
              "accessTokenUrl": "/api/v1/users/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
